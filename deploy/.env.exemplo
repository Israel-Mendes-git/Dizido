# Copie para a raiz do projeto como `.env` e preencha.
#
#   cp deploy/.env.exemplo .env
#
# O `.env` está no .gitignore. Este arquivo, que é só o modelo, fica versionado — assim ninguém
# precisa adivinhar quais variáveis existem, e nenhum segredo entra no git.
#
# Para gerar os valores aleatórios:
#
#   openssl rand -base64 48
#
# ou, sem openssl, no PowerShell:
#
#   [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))

# O domínio do app. Precisa apontar para esta máquina ANTES de subir: o Caddy tenta emitir o
# certificado no start, e o Let's Encrypt limita quantas tentativas falhas você pode fazer.
# Os anexos usam arquivos.<domínio>, então esse subdomínio também precisa apontar para cá.
DIZIDO_DOMINIO=dizido.exemplo.com.br

# Repositório das imagens no registro (usuário/nome, minúsculo).
DIZIDO_REPO=israel-mendes-git/dizido

# Senha do Postgres.
POSTGRES_PASSWORD=

# Chave de assinatura dos tokens. Mínimo 32 caracteres, e NUNCA a de desenvolvimento.
#
# Trocar esta chave invalida todas as sessões abertas: os tokens já emitidos deixam de ser
# verificáveis e todo mundo precisa entrar de novo. É o que se faz quando ela vaza.
JWT_SIGNING_KEY=

# Credenciais do storage.
MINIO_ROOT_USER=dizido
MINIO_ROOT_PASSWORD=

# Versão das imagens a implantar. Deixe em "latest" para acompanhar o último build da main;
# fixe no SHA de um commit para poder voltar atrás com precisão. Um deploy que deu errado se
# desfaz trocando esta linha e subindo de novo.
DIZIDO_VERSAO=latest

# Quantos dias de backup guardar na própria máquina.
BACKUP_RETENCAO_DIAS=14

# Para onde copiar cada backup, fora desta máquina. Sem isto, o incêndio que leva o banco
# leva os dumps junto. Formato "alias/bucket" — o alias é sempre "remoto".
#
#   BACKUP_DESTINO_REMOTO=remoto/dizido-backups
#   BACKUP_MC_HOST=https://CHAVE:SEGREDO@s3.exemplo.com
#
# Serve para AWS S3, Cloudflare R2, Backblaze B2 ou outro MinIO.
BACKUP_DESTINO_REMOTO=
BACKUP_MC_HOST=

# Coletor de telemetria (OTLP). Vazio desliga a exportação — a coleta continua acontecendo
# dentro do processo, só não vai para lugar nenhum.
OTEL_ENDPOINT=
