@implements IDisposable

@if (RespondendoA is { } citada)
{
    <div class="dz-composer__resposta">
        <span class="dz-composer__resposta-rotulo">respondendo a</span>
        <span class="dz-citacao__autor">@citada.SenderDisplayName</span>
        <span class="dz-citacao__trecho">@citada.Excerpt</span>

        <button type="button" class="dz-composer__anexo-tirar"
                title="Cancelar resposta" aria-label="Cancelar resposta"
                @onclick="AoCancelarResposta">✕</button>
    </div>
}

@if (_arquivo is not null)
{
    <div class="dz-composer__anexo">
        <span class="dz-composer__anexo-nome" title="@_arquivo.Name">📎 @_arquivo.Name</span>
        <span class="dz-composer__anexo-tamanho">@Tamanho(_arquivo.Size)</span>

        <button type="button" class="dz-composer__anexo-tirar" @onclick="TirarArquivo" title="Remover anexo">
            ✕
        </button>
    </div>
}

@if (_erro is not null)
{
    <p class="dz-composer__erro" role="alert">@_erro</p>
}

<form class="dz-composer" @onsubmit="Enviar" @onsubmit:preventDefault>
    @* O InputFile fica escondido e é acionado pelo label: o seletor nativo do navegador
       não aceita ser estilizado, e um botão que combina com o resto da interface vale
       mais do que a caixa cinza padrão. *@
    <label class="dz-composer__anexar" title="Anexar arquivo">
        📎
        <InputFile OnChange="AoEscolherArquivo" disabled="@(Desabilitado || _enviandoArquivo)" />
    </label>

    @if (_sugestoes.Count > 0)
    {
        @* Acima do campo, não abaixo: o campo fica na base da tela, e uma lista para baixo
           sairia da área visível. *@
        <ul class="dz-mencao-sugestoes" role="listbox" aria-label="Citar participante">
            @foreach (var (membro, indice) in _sugestoes.Select((m, i) => (m, i)))
            {
                <li @key="membro.UserId">
                    <button type="button"
                            role="option"
                            aria-selected="@(indice == _sugestaoAtiva)"
                            class="@(indice == _sugestaoAtiva ? "dz-mencao-sugestoes__ativa" : null)"
                            @onclick="() => EscolherMencao(membro)">
                        @membro.DisplayName
                    </button>
                </li>
            }
        </ul>
    }

    <textarea @ref="_campo"
              class="dz-composer__campo"
              rows="1"
              placeholder="Escreva uma mensagem"
              disabled="@Desabilitado"
              value="@_texto"
              @oninput="AoMudarTexto"
              @onkeydown="AoTeclar"></textarea>

    <button type="submit" class="dz-composer__enviar"
            disabled="@(Desabilitado || _enviandoArquivo || (string.IsNullOrWhiteSpace(_texto) && _arquivo is null))"
            title="Enviar (Enter)">
        @(_enviandoArquivo ? "Enviando…" : "Enviar")
    </button>
</form>

@code {
    /// <summary>O maior anexo aceito, em bytes. Tem que bater com o limite do domínio.</summary>
    private const long LimiteDeArquivo = 50L * 1024 * 1024;

    private string _texto = string.Empty;
    private ElementReference _campo;
    private Timer? _pararDeDigitar;
    private bool _sinalizouDigitando;
    private IBrowserFile? _arquivo;
    private bool _enviandoArquivo;
    private string? _erro;

    [Parameter] public bool Desabilitado { get; set; }

    /// <summary>Envia o texto com a lista de quem foi citado.</summary>
    [Parameter, EditorRequired] public EventCallback<TextoEnviado> AoEnviar { get; set; }

    /// <summary>O que sai do compositor: texto e quem foi citado nele.</summary>
    public sealed record TextoEnviado(string Texto, IReadOnlyList<Guid> Citados);

    /// <summary>
    /// Envia um arquivo com legenda opcional. Devolve a mensagem de erro, ou <c>null</c>.
    /// </summary>
    /// <remarks>
    /// O componente não sabe subir arquivo — quem sabe é o <c>ChatStore</c>. Ele só entrega
    /// o que o usuário escolheu e mostra o que voltou. É a mesma fronteira que mantém a
    /// pasta de componentes reaproveitável pelo app desktop da fase 10.
    /// </remarks>
    [Parameter] public Func<ArquivoEscolhido, Task<string?>>? AoEnviarArquivo { get; set; }

    [Parameter] public EventCallback<bool> AoDigitar { get; set; }

    /// <summary>A mensagem que está sendo respondida, se houver.</summary>
    /// <remarks>
    /// Vem de fora, e não de um estado interno, porque quem escolhe é o balão lá em cima —
    /// e é o <c>ChatShell</c> que faz a ponte entre os dois. Guardar aqui obrigaria o
    /// compositor a conhecer a lista de mensagens.
    /// </remarks>
    [Parameter] public MessageReplyPreview? RespondendoA { get; set; }

    [Parameter] public EventCallback AoCancelarResposta { get; set; }

    /// <summary>O que o usuário escolheu, pronto para subir.</summary>
    public sealed record ArquivoEscolhido(string Nome, string ContentType, long Tamanho, Stream Conteudo, string Legenda);

    /// <summary>Participantes que podem ser citados com <c>@</c>.</summary>
    [Parameter] public IReadOnlyList<ConversationMemberResponse> Membros { get; set; } = [];

    /// <summary>Quem está escrevendo — não faz sentido citar a si mesmo.</summary>
    [Parameter] public Guid MeuId { get; set; }

    private List<ConversationMemberResponse> _sugestoes = [];
    private int _sugestaoAtiva;

    /// <summary>
    /// Quem já foi citado nesta mensagem.
    /// </summary>
    /// <remarks>
    /// Acumulado conforme a pessoa escolhe no autocompletar. Na hora de enviar, a lista é
    /// filtrada pelo que ainda está escrito no texto: quem digitou "@Ana" e apagou depois não
    /// deve ser notificado.
    /// </remarks>
    private readonly List<ConversationMemberResponse> _citados = [];

    /// <summary>
    /// Procura um <c>@</c> em digitação no fim do texto e sugere quem combina.
    /// </summary>
    /// <remarks>
    /// <para>
    /// O gatilho é o último <c>@</c> do texto, e só vale se não houver espaço depois dele — ou
    /// se o que vem depois ainda casar com o começo de algum nome. É o que permite citar
    /// "Ana Souza" (com espaço) sem que a lista suma no meio do sobrenome.
    /// </para>
    /// <para>
    /// Um <c>@</c> colado em outra palavra não dispara nada: "contato@exemplo.com" continua
    /// sendo um email.
    /// </para>
    /// </remarks>
    private void AtualizarSugestoes()
    {
        _sugestoes = [];
        _sugestaoAtiva = 0;

        var arroba = _texto.LastIndexOf('@');

        if (arroba < 0)
        {
            return;
        }

        // Precisa estar no começo ou depois de um espaço. Sem isto, um email viraria menção.
        if (arroba > 0 && !char.IsWhiteSpace(_texto[arroba - 1]))
        {
            return;
        }

        var termo = _texto[(arroba + 1)..];

        _sugestoes = [.. Membros
            .Where(m => m.UserId != MeuId)
            .Where(m => m.DisplayName.StartsWith(termo, StringComparison.CurrentCultureIgnoreCase))
            .Take(6)];
    }

    private async Task EscolherMencao(ConversationMemberResponse membro)
    {
        var arroba = _texto.LastIndexOf('@');

        if (arroba >= 0)
        {
            // O espaço no fim é o que permite continuar escrevendo sem colar no nome — e é o
            // que faz a sugestão sumir, porque o termo deixa de casar.
            _texto = _texto[..arroba] + $"@{membro.DisplayName} ";
        }

        if (!_citados.Exists(c => c.UserId == membro.UserId))
        {
            _citados.Add(membro);
        }

        _sugestoes = [];
        await _campo.FocusAsync();
    }

    /// <summary>
    /// Quem continua citado no texto atual.
    /// </summary>
    /// <remarks>
    /// Confere o texto em vez de confiar na lista acumulada: quem escolheu alguém e depois
    /// apagou o nome não quer mais citá-lo — e notificá-lo seria uma interrupção que a pessoa
    /// não pediu e nem consegue explicar.
    /// </remarks>
    private IReadOnlyList<Guid> CitadosNoTexto() =>
        [.. _citados
            .Where(c => _texto.Contains($"@{c.DisplayName}", StringComparison.Ordinal))
            .Select(c => c.UserId)];

    /// <summary>
    /// Enter envia; Shift+Enter quebra linha.
    /// </summary>
    /// <remarks>
    /// É a convenção de todo app de mensagem, e contrariá-la é o tipo de detalhe que faz o
    /// usuário achar o produto estranho sem saber explicar por quê.
    /// </remarks>
    /// <summary>Atualiza o texto e reavalia as sugestões de menção.</summary>
    /// <remarks>
    /// oninput em vez de bind: o @bind atualiza o campo, mas não dá gancho para reagir à
    /// mudança. E precisa ser oninput, não onkeydown — colar um texto com @ tem que sugerir
    /// igual.
    /// </remarks>
    private async Task AoMudarTexto(ChangeEventArgs e)
    {
        _texto = e.Value?.ToString() ?? string.Empty;

        AtualizarSugestoes();

        await SinalizarDigitacao();
    }

    private async Task AoTeclar(KeyboardEventArgs e)
    {
        // Com a lista de sugestões aberta, as setas e o Enter pertencem a ela — não ao envio.
        // Sem este desvio, escolher alguém com o teclado mandaria a mensagem pela metade.
        if (_sugestoes.Count > 0)
        {
            switch (e.Key)
            {
                case "ArrowDown":
                    _sugestaoAtiva = (_sugestaoAtiva + 1) % _sugestoes.Count;
                    return;

                case "ArrowUp":
                    _sugestaoAtiva = (_sugestaoAtiva - 1 + _sugestoes.Count) % _sugestoes.Count;
                    return;

                case "Enter" or "Tab":
                    await EscolherMencao(_sugestoes[_sugestaoAtiva]);
                    return;

                case "Escape":
                    _sugestoes = [];
                    return;
            }
        }

        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await Enviar();
        }
    }

    /// <summary>
    /// Avisa "está digitando" no máximo uma vez a cada 3 segundos.
    /// </summary>
    /// <remarks>
    /// Sem esse controle, cada tecla vira um evento para cada membro do grupo — alguém
    /// escrevendo rápido geraria dezenas de mensagens por segundo, multiplicadas pelo número
    /// de participantes. O "parou de digitar" é enviado por um temporizador que reinicia a
    /// cada tecla.
    /// </remarks>
    private async Task SinalizarDigitacao()
    {
        if (!_sinalizouDigitando)
        {
            _sinalizouDigitando = true;
            await AoDigitar.InvokeAsync(true);
        }

        _pararDeDigitar?.Dispose();
        _pararDeDigitar = new Timer(async void (_) =>
        {
            try
            {
                _sinalizouDigitando = false;
                await AoDigitar.InvokeAsync(false);
            }
            catch (Exception)
            {
                // Callback de Timer é async void: uma exceção que escape daqui derruba
                // o processo inteiro. Perder um "parou de digitar" é inofensivo — o
                // indicador expira sozinho do outro lado.
            }
        }, null, TimeSpan.FromSeconds(3), Timeout.InfiniteTimeSpan);
    }

    private void AoEscolherArquivo(InputFileChangeEventArgs e)
    {
        _erro = null;

        var escolhido = e.File;

        // Recusar aqui, e não depois de subir: o servidor também confere, mas deixar o
        // usuário esperar o upload de um arquivo de 200 MB para só então dizer "não cabe"
        // seria desperdiçar a banda dele por nada.
        if (escolhido.Size > LimiteDeArquivo)
        {
            _erro = $"O arquivo tem {Tamanho(escolhido.Size)} e o limite é {Tamanho(LimiteDeArquivo)}.";
            _arquivo = null;
            return;
        }

        _arquivo = escolhido;
    }

    private void TirarArquivo()
    {
        _arquivo = null;
        _erro = null;
    }

    private async Task Enviar()
    {
        var texto = _texto.Trim();

        if (Desabilitado || _enviandoArquivo || (string.IsNullOrEmpty(texto) && _arquivo is null))
        {
            return;
        }

        _pararDeDigitar?.Dispose();
        _pararDeDigitar = null;

        if (_sinalizouDigitando)
        {
            _sinalizouDigitando = false;
            await AoDigitar.InvokeAsync(false);
        }

        if (_arquivo is { } arquivo && AoEnviarArquivo is not null)
        {
            await EnviarArquivoAsync(arquivo, texto);
        }
        else if (!string.IsNullOrEmpty(texto))
        {
            // Os citados são apurados ANTES de limpar o campo: CitadosNoTexto() confere quais
            // nomes ainda estão escritos, e num campo já vazio a resposta é sempre "nenhum".
            var citados = CitadosNoTexto();

            _texto = string.Empty;
            _citados.Clear();
            _sugestoes = [];

            await AoEnviar.InvokeAsync(new TextoEnviado(texto, citados));
        }

        await _campo.FocusAsync();
    }

    /// <summary>
    /// Sobe o arquivo escolhido, mantendo o que o usuário digitou caso falhe.
    /// </summary>
    /// <remarks>
    /// Ao contrário da mensagem de texto, que some do campo na hora porque a fila garante a
    /// entrega, o anexo só limpa depois de o servidor confirmar. Sem rede não há upload, e
    /// apagar a escolha do usuário o obrigaria a procurar o arquivo de novo.
    /// </remarks>
    private async Task EnviarArquivoAsync(IBrowserFile arquivo, string legenda)
    {
        _enviandoArquivo = true;
        _erro = null;

        try
        {
            await using var conteudo = arquivo.OpenReadStream(LimiteDeArquivo);

            var erro = await AoEnviarArquivo!(new ArquivoEscolhido(
                arquivo.Name,

                // Vazio quando o navegador não reconhece a extensão. O servidor trata isso
                // como arquivo comum, que é o desfecho seguro.
                arquivo.ContentType ?? string.Empty,
                arquivo.Size,
                conteudo,
                legenda));

            if (erro is not null)
            {
                _erro = erro;
                return;
            }

            _texto = string.Empty;
            _arquivo = null;
        }
        finally
        {
            _enviandoArquivo = false;
        }
    }

    private static string Tamanho(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
        _ => $"{bytes / (1024.0 * 1024.0):0.#} MB",
    };

    public void Dispose() => _pararDeDigitar?.Dispose();
}
