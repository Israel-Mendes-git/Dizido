@* Um balão de mensagem. *@

<div class="dz-bubble-row @(EhMinha ? "dz-bubble-row--minha" : null)">
    @if (!EhMinha && MostrarAutor)
    {
        <Avatar Nome="@Mensagem.Dados.SenderDisplayName" />
    }
    else if (!EhMinha)
    {
        <div class="dz-bubble-espacador"></div>
    }

    <div class="dz-bubble @(EhMinha ? "dz-bubble--minha" : null) @(Mensagem.Estado == EstadoEnvio.Falhou ? "dz-bubble--falhou" : null) @(Mensagem.Dados.IsDeleted ? "dz-bubble--apagada" : null)">
        @if (!EhMinha && MostrarAutor)
        {
            <div class="dz-bubble__autor">@Mensagem.Dados.SenderDisplayName</div>
        }

        @if (Mensagem.Dados.IsDeleted)
        {
            @* A mensagem some do conteúdo mas não da lista: quem estava lendo não perde a
               posição, e uma resposta que aponte para ela continua fazendo sentido. *@
            <div class="dz-bubble__apagada">esta mensagem foi apagada</div>
        }
        else if (_editando)
        {
            <div class="dz-bubble__edicao">
                <textarea class="dz-bubble__edicao-campo"
                          rows="2"
                          aria-label="Editar mensagem"
                          @bind="_rascunho"
                          @bind:event="oninput"
                          @onkeydown="AoTeclarNaEdicao"></textarea>

                @if (_erro is not null)
                {
                    <p class="dz-bubble__erro" role="alert">@_erro</p>
                }

                <div class="dz-bubble__edicao-acoes">
                    <button type="button" class="dz-bubble__acao" @onclick="Cancelar">cancelar</button>
                    <button type="button" class="dz-bubble__acao dz-bubble__acao--principal"
                            disabled="@_salvando" @onclick="Salvar">
                        @(_salvando ? "salvando…" : "salvar")
                    </button>
                </div>
            </div>
        }
        else
        {
            @* A citação vem pronta do servidor: a mensagem original pode estar centenas de
               páginas atrás, fora de tudo que o cliente carregou. *@
            @if (Mensagem.Dados.ReplyTo is { } citada)
            {
                <div class="dz-citacao @(citada.IsDeleted ? "dz-citacao--apagada" : null)">
                    <span class="dz-citacao__autor">@citada.SenderDisplayName</span>
                    <span class="dz-citacao__trecho">@citada.Excerpt</span>
                </div>
            }

            @if (Mensagem.Dados.Attachment is { } anexo)
            {
                <AttachmentView Anexo="anexo" AoExpirar="AoExpirarAnexo" />
            }

            @* Com anexo, o corpo é legenda e costuma vir vazio — não vale ocupar espaço. *@
            @if (!string.IsNullOrEmpty(Mensagem.Dados.Body))
            {
                <div class="dz-bubble__texto">
                    <MessageText Texto="@Mensagem.Dados.Body"
                                 Mencionados="@Mensagem.Dados.MentionedUserIds"
                                 Membros="Membros"
                                 MeuId="MeuId" />
                </div>
            }
        }

        @if (!Mensagem.Dados.IsDeleted)
        {
            <ReactionBar Reacoes="@(Mensagem.Dados.Reactions ?? [])"
                         MeuId="MeuId"
                         Membros="Membros"
                         Escolhendo="_escolhendoReacao"
                         AoAlternar="@(PodeReagir ? Reagir : null)"
                         AoEscolher="() => _escolhendoReacao = false" />
        }

        @if (_erroReacao is not null)
        {
            <p class="dz-bubble__erro" role="alert">@_erroReacao</p>
        }

        <div class="dz-bubble__rodape">
            @if (Mensagem.Dados.EditedAt is not null && !Mensagem.Dados.IsDeleted)
            {
                <span class="dz-bubble__editada">editada</span>
            }

            <time datetime="@Mensagem.Dados.SentAt.ToString("o")">
                @Mensagem.Dados.SentAt.ToLocalTime().ToString("HH:mm")
            </time>

            @if (EhMinha)
            {
                <span class="dz-bubble__estado @(Mensagem.Estado == EstadoEnvio.Lida ? "dz-bubble__estado--lida" : null)"
                      title="@Titulo">@Icone</span>
            }
        </div>

        @if (Mensagem.Estado == EstadoEnvio.Falhou)
        {
            <button type="button" class="dz-bubble__reenviar" @onclick="Reenviar">
                não enviou — tentar de novo
            </button>
        }

        @if (_registrandoDecisao)
        {
            <div class="dz-decisao-registro">
                <label>
                    O que ficou decidido?
                    <input type="text" maxlength="280"
                           placeholder="e o porquê, em uma linha"
                           aria-label="Resumo da decisão"
                           @bind="_resumoDaDecisao" @bind:event="oninput" />
                </label>

                @if (_erro is not null)
                {
                    <p class="dz-bubble__erro" role="alert">@_erro</p>
                }

                <div class="dz-bubble__edicao-acoes">
                    <button type="button" class="dz-bubble__acao"
                            @onclick="CancelarDecisao">cancelar</button>
                    <button type="button" class="dz-bubble__acao dz-bubble__acao--principal"
                            disabled="@(_salvandoDecisao || string.IsNullOrWhiteSpace(_resumoDaDecisao))"
                            @onclick="RegistrarDecisao">
                        @(_salvandoDecisao ? "registrando…" : "registrar")
                    </button>
                </div>
            </div>
        }

        @* As ações ficam escondidas até o ponteiro passar pelo balão (regra de CSS), mas
           continuam no DOM e alcançáveis por teclado — o contrário excluiria quem não usa
           mouse de editar as próprias mensagens. *@
        @if (PodeResponder || PodeEditar || PodeApagar || PodeRegistrarDecisao || PodeReagir)
        {
            <div class="dz-bubble__acoes">
                @if (PodeReagir)
                {
                    @* O seletor abre daqui, e não de um "+" fixo embaixo de cada balão: um
                       botão permanente em toda mensagem polui a leitura de uma conversa
                       inteira para servir a um clique ocasional. *@
                    <button type="button"
                            class="dz-bubble__acao @(_escolhendoReacao ? "dz-bubble__acao--principal" : null)"
                            title="Reagir" aria-label="Reagir a esta mensagem"
                            aria-expanded="@_escolhendoReacao"
                            @onclick="AlternarSeletor">reagir</button>
                }

                @if (PodeResponder)
                {
                    <button type="button" class="dz-bubble__acao"
                            title="Responder" aria-label="Responder a esta mensagem"
                            @onclick="Responder">responder</button>
                }

                @if (PodeRegistrarDecisao)
                {
                    <button type="button" class="dz-bubble__acao"
                            title="Guardar o que ficou combinado aqui"
                            aria-label="Registrar esta mensagem como decisão"
                            @onclick="AbrirDecisao">decisão</button>
                }

                @if (PodeEditar)
                {
                    <button type="button" class="dz-bubble__acao"
                            title="Editar" aria-label="Editar mensagem"
                            @onclick="Editar">editar</button>
                }

                @if (PodeApagar)
                {
                    <button type="button" class="dz-bubble__acao"
                            title="Apagar" aria-label="Apagar mensagem"
                            @onclick="Apagar">apagar</button>
                }
            </div>
        }
    </div>
</div>

@code {
    private bool _editando;
    private bool _salvando;
    private bool _registrandoDecisao;
    private bool _salvandoDecisao;
    private bool _escolhendoReacao;
    private string? _erroReacao;
    private string _resumoDaDecisao = string.Empty;
    private string _rascunho = string.Empty;
    private string? _erro;

    [Parameter, EditorRequired] public MensagemNaTela Mensagem { get; set; } = null!;

    [Parameter] public bool EhMinha { get; set; }

    /// <summary>Falso quando a mensagem anterior é do mesmo autor — evita repetir nome e avatar.</summary>
    [Parameter] public bool MostrarAutor { get; set; } = true;

    /// <summary>Se quem está vendo é administrador ou dono do grupo.</summary>
    /// <remarks>
    /// Só afeta o que a tela oferece. Quem decide de verdade é o servidor, que refaz a mesma
    /// pergunta ao domínio — esconder um botão não é controle de acesso.
    /// </remarks>
    [Parameter] public bool PodeModerar { get; set; }

    /// <summary>Participantes da conversa, para reconhecer os nomes citados no texto.</summary>
    [Parameter] public IReadOnlyList<ConversationMemberResponse> Membros { get; set; } = [];

    /// <summary>Quem está lendo — uma menção a você fica em destaque mais forte.</summary>
    [Parameter] public Guid MeuId { get; set; }

    [Parameter] public EventCallback<MensagemNaTela> AoReenviar { get; set; }

    /// <summary>Repassa o pedido de renovar a URL assinada de um anexo que expirou.</summary>
    [Parameter] public EventCallback<Guid> AoExpirarAnexo { get; set; }

    /// <summary>Salva o texto novo. Devolve a mensagem de erro, ou <c>null</c>.</summary>
    [Parameter] public Func<MensagemNaTela, string, Task<string?>>? AoEditar { get; set; }

    /// <summary>Apaga a mensagem. Devolve a mensagem de erro, ou <c>null</c>.</summary>
    [Parameter] public Func<MensagemNaTela, Task<string?>>? AoApagar { get; set; }

    /// <summary>Põe esta mensagem como a que o compositor vai responder.</summary>
    [Parameter] public EventCallback<MensagemNaTela> AoResponder { get; set; }

    /// <summary>
    /// Responder vale para mensagem de qualquer pessoa, inclusive a própria.
    /// </summary>
    /// <remarks>
    /// Não se responde a uma mensagem ainda na fila: ela não tem id no servidor, e a citação
    /// apontaria para o nada quando finalmente saísse.
    /// </remarks>
    private bool PodeResponder =>
        AoResponder.HasDelegate
        && !Mensagem.Dados.IsDeleted
        && !Mensagem.EhProvisoria
        && !_editando;

    /// <summary>
    /// Só o autor edita, e só o que já foi gravado.
    /// </summary>
    /// <remarks>
    /// Uma mensagem ainda na fila não tem id no servidor para ser editada. O caminho natural
    /// para mudar o que está saindo é apagar e escrever de novo — ela ainda não chegou a
    /// ninguém.
    /// </remarks>
    private bool PodeEditar =>
        AoEditar is not null
        && EhMinha
        && !Mensagem.Dados.IsDeleted
        && !Mensagem.EhProvisoria
        && !_editando;

    private bool PodeApagar =>
        AoApagar is not null
        && (EhMinha || PodeModerar)
        && !Mensagem.Dados.IsDeleted
        && !Mensagem.EhProvisoria
        && !_editando;

    // A convenção que todo mundo já conhece de outros aplicativos: um traço para "saindo",
    // um tique para "o servidor recebeu", dois para "todos leram". Inventar símbolos novos
    // aqui só obrigaria o usuário a aprender algo que ele já sabe.
    private string Icone => Mensagem.Estado switch
    {
        EstadoEnvio.Enviando => "🕘",
        EstadoEnvio.Enviada => "✓",
        EstadoEnvio.Lida => "✓✓",
        _ => "⚠",
    };

    private string Titulo => Mensagem.Estado switch
    {
        EstadoEnvio.Enviando => "na fila de envio",
        EstadoEnvio.Enviada => "entregue ao servidor",
        EstadoEnvio.Lida => "lida por todos",
        _ => "não foi enviada",
    };

    private Task Reenviar() => AoReenviar.InvokeAsync(Mensagem);

    private Task Responder() => AoResponder.InvokeAsync(Mensagem);

    /// <summary>Põe ou tira a reação. Devolve a mensagem de erro, ou <c>null</c>.</summary>
    [Parameter] public Func<MensagemNaTela, string, Task<string?>>? AoReagir { get; set; }

    /// <summary>
    /// Reagir vale para mensagem de qualquer pessoa, inclusive a própria.
    /// </summary>
    /// <remarks>
    /// Não se reage a uma mensagem ainda na fila: ela não tem id no servidor, e a reação não
    /// teria onde ser gravada. Nem a uma apagada — o servidor recusa, e é o mesmo motivo pelo
    /// qual o balão já não mostra conteúdo.
    /// </remarks>
    private bool PodeReagir =>
        AoReagir is not null
        && !Mensagem.Dados.IsDeleted
        && !Mensagem.EhProvisoria
        && Mensagem.Dados.Kind != "System"
        && !_editando;

    private void AlternarSeletor()
    {
        _escolhendoReacao = !_escolhendoReacao;
        _erroReacao = null;
    }

    private async Task<string?> Reagir(string emoji)
    {
        _erroReacao = await AoReagir!(Mensagem, emoji);

        return _erroReacao;
    }

    /// <summary>
    /// Registra a mensagem como decisão. Devolve a mensagem de erro, ou <c>null</c>.
    /// </summary>
    /// <remarks>
    /// Qualquer participante pode registrar, não só administradores: quem percebe que algo
    /// ficou decidido raramente é quem manda no grupo.
    /// </remarks>
    [Parameter] public Func<MensagemNaTela, string, Task<string?>>? AoRegistrarDecisao { get; set; }

    private bool PodeRegistrarDecisao =>
        AoRegistrarDecisao is not null
        && !Mensagem.Dados.IsDeleted
        && !Mensagem.EhProvisoria
        && Mensagem.Dados.Kind != "System"
        && !_editando
        && !_registrandoDecisao;

    private void AbrirDecisao()
    {
        // O texto da mensagem entra como ponto de partida, para editar em vez de escrever do
        // zero. Mas continua editável de propósito: o valor da decisão está no resumo que
        // alguém escreve, não no que foi dito no calor da conversa.
        _resumoDaDecisao = Mensagem.Dados.Body.Length <= 280
            ? Mensagem.Dados.Body
            : Mensagem.Dados.Body[..280];

        _erro = null;
        _registrandoDecisao = true;
    }

    private void CancelarDecisao()
    {
        _registrandoDecisao = false;
        _erro = null;
    }

    private async Task RegistrarDecisao()
    {
        _salvandoDecisao = true;
        _erro = null;

        try
        {
            _erro = await AoRegistrarDecisao!(Mensagem, _resumoDaDecisao.Trim());

            if (_erro is null)
            {
                _registrandoDecisao = false;
                _resumoDaDecisao = string.Empty;
            }
        }
        finally
        {
            _salvandoDecisao = false;
        }
    }

    private void Editar()
    {
        _rascunho = Mensagem.Dados.Body;
        _erro = null;
        _editando = true;
    }

    private void Cancelar()
    {
        _editando = false;
        _erro = null;
    }

    /// <summary>Enter salva, Escape cancela — as mesmas teclas do compositor.</summary>
    private async Task AoTeclarNaEdicao(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            Cancelar();
        }
        else if (e.Key == "Enter" && !e.ShiftKey)
        {
            await Salvar();
        }
    }

    private async Task Salvar()
    {
        var texto = _rascunho.Trim();

        // Esvaziar o texto de uma mensagem sem anexo seria apagá-la, e para isso existe o
        // botão ao lado. O servidor recusaria de qualquer forma; barrar aqui evita uma ida
        // à rede para receber um "não".
        if (texto.Length == 0 && Mensagem.Dados.Attachment is null)
        {
            _erro = "Para deixar a mensagem vazia, apague-a.";
            return;
        }

        if (texto == Mensagem.Dados.Body)
        {
            Cancelar();
            return;
        }

        _salvando = true;
        _erro = null;

        try
        {
            _erro = await AoEditar!(Mensagem, texto);

            if (_erro is null)
            {
                _editando = false;
            }
        }
        finally
        {
            _salvando = false;
        }
    }

    private async Task Apagar()
    {
        _erro = await AoApagar!(Mensagem);
    }
}
